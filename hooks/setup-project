# pi loads ~/.pi/agent/AGENTS.md as its global context file.
AGENTS_MD="/home/workshop/.pi/agent/AGENTS.md"
mkdir -p "$(dirname "$AGENTS_MD")"

# Conditionally write AGENTS.md — do not overwrite if user already has one
if [[ ! -f "$AGENTS_MD" ]]; then
    cp "${SDK}/workshop-prompt.md" "$AGENTS_MD"
elif ! grep -Fq "$(head -1 "${SDK}/workshop-prompt.md")" "$AGENTS_MD"; then
    printf '\n' >> "$AGENTS_MD"
    cat "${SDK}/workshop-prompt.md" >> "$AGENTS_MD"
fi
